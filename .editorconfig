root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,xml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# xUnit test names use underscores to preserve scenario readability and traceability.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none

# EF Core owns these generated migration artifacts; sealing them would be overwritten.
[src/**/Infrastructure/Persistence/Migrations/*.cs]
dotnet_diagnostic.CA1852.severity = none
dotnet_diagnostic.CA1861.severity = none
