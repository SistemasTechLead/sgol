@model Sgol.Web.Pages.MyWork.IndexModel
@using Sgol.Web.Pages.Tasks
@using Sgol.Web.Presentation.MyWork
@using WorkModel = Sgol.Web.Pages.MyWork.IndexModel
<section id="plan-tasks" class="panel-seccion" aria-labelledby="plan-tasks-title" data-work-now="@Model.OperationalNow.ToUnixTimeMilliseconds()" data-work-day-start="@Sgol.Web.Infrastructure.Persistence.Planning.OperationalSchedule.Instant(Model.OperationalDay).ToUnixTimeMilliseconds()" data-work-day-end="@Sgol.Web.Infrastructure.Persistence.Planning.OperationalSchedule.Instant(Model.OperationalDay.AddDays(1)).ToUnixTimeMilliseconds()">
    <header class="panel-seccion__cabecera"><h2 id="plan-tasks-title">Tus tareas asignadas</h2></header>
    <p class="my-work-guide">Las tareas se ordenan por color: rojas, verdes, amarillas, grises y azules, sin importar su fecha. Dentro de cada color aparecen primero las de vencimiento más antiguo. Selecciona <strong>Adjuntar evidencia</strong> para preparar tu entrega y enviarla a revisión, o <strong>Ver evidencia</strong> para consultar una entrega enviada.</p>
    <form method="get" action="/mi-trabajo#plan-tasks" class="supervision-filters"><label class="campo"><span class="campo__etiqueta">Buscar en todas tus asignaciones</span><input type="search" class="campo__control" name="WorkSearch" value="@Model.Request.Query["WorkSearch"]" /></label><button class="boton boton--secundario" type="submit">Buscar</button><a class="boton boton--textual" href="/mi-trabajo#plan-tasks">Limpiar</a></form>
    @if (Model.WorkPagination is {} pagination) { <partial name="_ListPage" model="pagination" /> }
    <div class="my-work-desktop-legend"><partial name="_TaskColorLegend" /></div>
    @if (Model.OperationalError is not null && Model.OperationalSelectedTask is null) { <p class="alerta alerta--peligro" role="alert">@Model.OperationalError</p> }
    @if (Model.OperationalTasks.Count == 0 && Model.OperationalError is null) { <p class="estado-vacio">No hay tareas que coincidan con esta consulta.</p> }
    else if (Model.OperationalTasks.Count > 0) {
        <section class="my-work-plan" aria-labelledby="assigned-work-title">
            <header class="my-work-plan__header">
                <div><h3 id="assigned-work-title">Todas tus asignaciones</h3></div>
                @if (Model.WorkProgress.Total == 0 && Model.OperationalTasks.Any(t => t.PendingProcessRunId != null)) {
                    <small>Sin tareas habilitadas para hoy.</small>
                } else {
                    <partial name="_TaskProgress" model="@(Model.WorkProgress)" />
                }
                <span class="my-work-plan__count">@Model.WorkPagination?.Total tareas</span>
            </header>
            <partial name="_OperationalTaskTable" model="@((Model, Model.OperationalOrderedTasks, true))" />
        </section>
    }
</section>
<partial name="_OperationalTaskDialog" model="Model" />
@if (Model.OperationalTransfers.Count > 0) {
    <details class="panel-seccion"><summary>Historial de transferencias (últimos 100 movimientos)</summary>
        <ul>@foreach (var t in Model.OperationalTransfers) { <li><strong>@t.TaskName</strong> · @MyWorkPresentation.Time(t.At) · @t.FromName → @t.ToName · @t.ProgressUnits unidades conservadas · @t.RemainingMinutes min pendientes · @t.Reason</li> }</ul>
    </details>
}
