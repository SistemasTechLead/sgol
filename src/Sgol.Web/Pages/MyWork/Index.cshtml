@page "/mi-trabajo"
@model Sgol.Web.Pages.MyWork.IndexModel
@{ ViewData["Title"] = "Mi trabajo"; }
<section aria-labelledby="mi-trabajo-titulo">
    <header class="encabezado-pagina my-work-heading">
        <div class="encabezado-pagina__contenido">
            <h1 id="mi-trabajo-titulo" class="encabezado-pagina__titulo">Mi trabajo</h1>
            <p class="encabezado-pagina__descripcion">Consulta tus tareas asignadas y entrega la evidencia de tu trabajo.</p>
        </div>
        @if (Model.Bonus is {} bonus) {
            <aside class="my-work-bonus" data-bonus-feed="@Url.Page("/MyWork/Index", "Bonus", new { BonusWeek = bonus.Period.StartsOn.ToString("yyyy-MM-dd") })">
                <partial name="_TaskBonusGauge" model="@(new TaskBonusGaugeViewModel(bonus))" />
                <form method="get" class="bonus-week"><label class="solo-lectores" for="my-bonus-week">Semana del bono</label><select id="my-bonus-week" name="BonusWeek" class="campo__control">
                    <option value="@Model.BonusCurrentWeek.ToString("yyyy-MM-dd")" selected="@(bonus.Period.StartsOn == Model.BonusCurrentWeek)">Actual · @Model.BonusCurrentWeek.ToString("d/M")–@Model.BonusCurrentWeek.AddDays(6).ToString("d/M")</option>
                    <option value="@Model.BonusCurrentWeek.AddDays(-7).ToString("yyyy-MM-dd")" selected="@(bonus.Period.StartsOn != Model.BonusCurrentWeek)">Anterior · @Model.BonusCurrentWeek.AddDays(-7).ToString("d/M")–@Model.BonusCurrentWeek.AddDays(-1).ToString("d/M")</option>
                </select><button class="boton boton--secundario" type="submit">Ver</button></form>
                <p data-bonus-status role="status" aria-live="polite"></p>
            </aside>
        }
        @if (Model.BonusError != null) { <p role="status">@Model.BonusError</p> }
        <partial name="_SectionNavigation" model='@("my-work")' />
        @if (Model.ErrorTitle is null)
        {
            <details class="my-work-mobile-only my-work-help">
                <summary aria-label="Información sobre tus tareas y sus colores" title="Información sobre tus tareas"><partial name="_Icon" model='@("info")' /></summary>
                <div class="my-work-help__content">
                    <p>Las tareas aparecen por color: rojas, verdes, amarillas, grises y azules. Abre cada tarea para preparar tu entrega o consultar su evidencia.</p>
                    <partial name="_TaskColorLegend" />
                </div>
            </details>
        }
    </header>
    @if (Model.ErrorTitle is not null)
    {
        <div class="alerta alerta--peligro" role="alert" id="session-error" tabindex="-1"><div class="alerta__contenido"><strong>@Model.ErrorTitle</strong><p>@Model.ErrorMessage</p></div></div>
    }
    else
    {
        @if (TempData["OperationalSuccess"] is string success) { <p class="alerta alerta--exito" role="status">@success</p> }
        <partial name="_OperationalTasks" model="Model" />
    }
</section>
@section Scripts {
    <script src="~/js/camera-capture.js" asp-append-version="true"></script>
    <script src="~/js/occasion-material.js" asp-append-version="true"></script><script src="~/js/assigned-tasks.js" asp-append-version="true"></script>
    <script src="~/js/my-work-timing.js" asp-append-version="true"></script>
    <script src="~/js/task-bonus.js" asp-append-version="true"></script>
}

