@model Sgol.Web.Pages.MyWork.IndexModel
@using Sgol.Web.Presentation.MyWork
<section class="mi-trabajo__seccion" id="mis-tareas" aria-labelledby="mis-tareas-title">
    <h2 id="mis-tareas-title">Mis tareas</h2>
    @if (Model.Inbox?.Period is { } period)
    { <p>@MyWorkPresentation.Period(period.IsoYear, period.IsoWeek, period.StartsOn, period.EndsOn) — Hora de Ciudad de México</p> }
    <form method="get" action="/mi-trabajo#mis-tareas" class="tabla-filtros" data-work-query="mis-tareas">
        @foreach (var pair in Model.Query.HiddenExcept("taskState", "taskCursor")) { <input type="hidden" name="@pair.Key" value="@pair.Value" /> }
        <label class="campo"><span class="campo__etiqueta">Estado de mis tareas</span>
            <select class="campo__control" name="taskState"><option value="">Todos</option>
                @foreach (var state in new[] { "FUTURA", "DISPONIBLE", "VENCIDA", "CONCLUIDA" })
                { <option value="@state" selected="@(Model.Query["taskState"] == state)">@MyWorkPresentation.Badge(state).Text</option> }
            </select>
        </label>
        <button class="boton boton--secundario" type="submit">Aplicar filtros</button>
        <a class="boton boton--secundario" href="@Model.Query.Href("mis-tareas", ("taskState", null), ("taskCursor", null))">Limpiar filtros</a>
        <a class="boton boton--secundario" href="@Model.Query.Href("mis-tareas", ("periodId", null), ("taskCursor", null))">Semana actual</a>
    </form>
    <div class="tabla-contenedor"><table class="tabla"><caption>Tareas propias del período</caption>
        <thead class="tabla__encabezado"><tr><th scope="col">Tarea</th><th scope="col">Período</th><th scope="col">Origen</th><th scope="col">Ejecución y situación</th><th scope="col">Vencimiento</th><th scope="col">Evidencia</th><th scope="col">Consulta</th></tr></thead>
        <tbody>
            @foreach (var item in Model.Inbox?.Tasks.Items ?? [])
            {
                <tr class="tabla__fila" data-own-task="@item.ObligationId"><td>@item.Task.TaskCode · @item.Task.Name</td>
                    <td>@MyWorkPresentation.Period(item.Period.IsoYear, item.Period.IsoWeek, item.Period.StartsOn, item.Period.EndsOn)</td>
                    <td>@MyWorkPresentation.Origin(item.OriginKind)</td>
                    <td><partial name="_StatusBadge" model="@MyWorkPresentation.Badge(item.ExecutionStatus)" />
                        @if (item.TaskState != "CONCLUIDA") { <partial name="_StatusBadge" model="@MyWorkPresentation.Badge(item.TaskState)" /> }
                    </td>
                    <td><time datetime="@item.Dates.DueAt?.ToString("O")">@MyWorkPresentation.Time(item.Dates.DueAt)</time></td>
                    <td><partial name="_StatusBadge" model="@MyWorkPresentation.Badge(item.Evidence.Result)" />
                        @if (item.Evidence.MissingRequirements.Count > 0)
                        { <ul>@foreach (var missing in item.Evidence.MissingRequirements) { <li>@missing.RequirementCode — @MyWorkPresentation.MissingReason(missing.MissingReason)</li> }</ul> }
                    </td>
                    <td>@if (Model.CanViewTasks && item.AllowedActions.Contains("VIEW_TASK"))
                        { <a class="boton boton--secundario tabla__accion" href="@Model.DetailHref(item.ObligationId)">Ver tarea</a> }
                    </td>
                </tr>
            }
        </tbody>
    </table></div>
    @if (Model.Inbox?.Tasks.IsEmpty == true)
    { <partial name="_EmptyState" model="@(new EmptyStateViewModel(Model.Query["taskState"] is null ? "No hay tareas propias en este período" : "No hay tareas que coincidan con estos filtros", ActionLabel: "Limpiar filtros", ActionHref: Model.Query.Href("mis-tareas", ("taskState", null), ("taskCursor", null))))" /> }
    @if (Model.TaskPagination is not null) { <partial name="_WorkPagination" model="Model.TaskPagination" /> }
</section>
