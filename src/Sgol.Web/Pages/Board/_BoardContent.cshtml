@model Sgol.Web.Infrastructure.Persistence.Planning.LiveBoardSnapshot
@using Sgol.Web.Infrastructure.Persistence.Planning
@{
    var end = OperationalSchedule.Instant(Model.Day.AddDays(1));
    var spanish = System.Globalization.CultureInfo.GetCultureInfo("es-MX");
    var namesakes = Model.BoardTasks.GroupBy(t => t.PersonName.Trim(), StringComparer.OrdinalIgnoreCase)
        .Where(g => g.Select(t => t.PersonId).Distinct().Count() > 1)
        .Select(g => g.Key).ToHashSet(StringComparer.OrdinalIgnoreCase);
    var people = Model.BoardTasks.Select(t => t.PersonId).Distinct().ToArray();
}
<div class="board-content" data-server-now="@Model.Now.ToUnixTimeMilliseconds()" data-day-end="@end.ToUnixTimeMilliseconds()" data-day="@Model.Day.ToString("yyyy-MM-dd")" data-plan="@Model.PlanId" data-task="@Model.TaskFilter" data-state="@Model.StateFilter">
    <header class="board-header">
        <div class="board-heading">
            <h1>Tablero</h1>
            @if (Sgol.Web.Infrastructure.Authentication.ScreenAuthentication.IsScreen(User)) {
                <a class="board-action" href="/tablero/rol-de-tareas">Ver Rol de Tareas</a>
            } else { <partial name="_SectionNavigation" model='@("board")' /> }
        </div>
        <div class="board-context">
            <div class="board-context__date"><time datetime="@Model.Day.ToString("yyyy-MM-dd")" title="@Model.Day.ToString("dd/MM/yyyy")">@Model.DayName, @Model.Day.ToString("d 'de' MMMM", spanish)</time><span class="board-live" data-live-status>Conectando…</span></div>
            <span>Jornada 08:00–20:00 · Ciudad de México</span>
        </div>
        <form class="board-plan" method="get" action="/tablero">
            <div class="board-filter">
            <label for="board-plan">Plan de trabajo</label>
            <select id="board-plan" name="plan" aria-label="Plan de trabajo">
                <option value="" selected="@(Model.PlanId is null)">Cierre hoy y críticas vencidas</option>
                @foreach (var plan in Model.Plans) {
                    <option value="@plan.Id" selected="@(plan.Id == Model.PlanId)">@plan.Name</option>
                }
            </select>
            </div>
            <div class="board-filter">
            <label for="board-task">Consultar tarea</label>
            <select id="board-task" name="task" aria-label="Consultar tarea">
                <option value="" selected="@(Model.TaskFilter is null)">Todas las tareas del tablero</option>
                <optgroup label="Estados de la tarea">
                @foreach (var state in LiveBoardSnapshot.States) {
                    <option value="state:@state" selected="@(state == Model.StateFilter)">@LiveBoardSnapshot.StateLabel(state)</option>
                }
                </optgroup>
                <optgroup label="Tareas individuales">
                @foreach (var task in Model.TaskOptions) {
                    <option value="@task.Id" selected="@(task.Id == Model.TaskId)">@task.Name · @task.PersonName · @task.PlanName</option>
                }
                </optgroup>
            </select>
            </div>
            <noscript><button type="submit">Ver plan</button></noscript>
        </form>
    </header>
    <div class="board-progress-pair">
        <partial name="/Pages/Board/_BoardProgress.cshtml" model='@(new BoardProgressViewModel("day", "Día", Model.Day, Model.DayDeadlines, Model.Now))' />
        <partial name="/Pages/Board/_BoardProgress.cshtml" model='@(new BoardProgressViewModel("week", "Semana", Model.WeekStartsOn, Model.WeeklyDeadlines ?? [], Model.Now))' />
    </div>
    @if (Model.Collaborators.Any()) {
        <div class="board-collaborator-progress" role="group" aria-label="Progreso diario por colaborador">
            @foreach (var collaborator in Model.Collaborators) {
                var progress = new BoardProgressViewModel($"person-{collaborator.Key:N}", collaborator.First().PersonName, Model.Day,
                    collaborator.Select(t => new LiveBoardDeadline(t.DueAt, t.CompletedAt)).ToArray(), Model.Now, collaborator.Key);
                <partial name="/Pages/Board/_BoardProgress.cshtml" model="progress" />
            }
        </div>
    }
    <div class="board-viewport" tabindex="0" aria-label="Tareas del tablero; usa las flechas para desplazarte">
        <div class="board-empty" data-board-empty hidden="@(Model.VisibleTasks.Any())"><partial name="_Icon" model='@("calendar")' /><h2>No hay tareas para mostrar</h2><p>@(Model.StateFilter is not null ? "No hay tareas con el estado seleccionado en esta consulta." : Model.PlanId is not null ? "Este plan no tiene tareas con cierre hoy ni críticas vencidas pendientes." : "No hay tareas con cierre hoy ni críticas vencidas pendientes.")</p></div>
    <div class="board-grid">
            @foreach (var task in Model.OrderedTasks) {
                var color = task.Color(Model.Now);
                var state = color switch { "scheduled" => "Por activar", "active" => "Activa", "warning" => "Último 30% del tiempo", "urgent" => task.DueAt <= Model.Now ? "Vencida" : "Último 10% del tiempo", _ => "Entregada" };
                var activation = TimeZoneInfo.ConvertTime(task.StartsAt, OperationalSchedule.Zone);
                var previousDeadline = task.DueAt < OperationalSchedule.Instant(Model.Day);
                var personKey = task.PersonId.ToString("N");
                var keyLength = 6;
                while (keyLength < personKey.Length && people.Any(id => id != task.PersonId && id.ToString("N").EndsWith(personKey[^keyLength..], StringComparison.Ordinal))) { keyLength++; }
                var compactPlan = task.Origin == "Plan de Operaciones Semanal"
                    ? System.Text.RegularExpressions.Regex.Replace(task.PlanName, @"\bSemana\s+(\d{1,2})\b", "Sem. $1", System.Text.RegularExpressions.RegexOptions.IgnoreCase)
                    : task.PlanName;
                <article class="board-card board-card--@color" hidden="@(Model.StateFilter is not null && task.State(Model.Now) != Model.StateFilter)" data-task-id="@task.Id" data-start="@task.StartsAt.ToUnixTimeMilliseconds()" data-due="@task.DueAt.ToUnixTimeMilliseconds()" data-delivered="@(task.CompletedAt is not null ? "true" : "false")">
                    <partial name="~/Pages/Shared/_CarryoverTiming.cshtml" model="@((task.Id, task.DueAt, task.CompletedAt))" />
                    <div class="board-card__top">
                        <span class="board-card__state">@(color == "delivered" ? "✓ " : "")@state</span>
                        @if (task.Origin == "Plan de Operaciones Semanal") {
                            <span class="board-card__plan" title="@task.PlanName">@compactPlan</span>
                        }
                    </div>
                    <h3>@task.Name</h3>
                    @if (previousDeadline) {
                        <p class="board-card__origin">Venció el @Model.Time(task.DueAt)</p>
                    }
                    @if (task.Origin != "Plan de Operaciones Semanal") {
                        <p class="board-card__origin">@task.Origin · @task.PlanName</p>
                    }
                    <dl>
                        <div class="board-card__person">
                            <dt class="solo-lectores">Responsable</dt>
                            <dd>
                                <span class="board-avatar"><partial name="_PersonAvatar" model="@(new PersonAvatarViewModel(task.PersonId, task.PersonName))" /></span>
                                <span class="board-card__identity">@task.PersonName
                                    @if (namesakes.Contains(task.PersonName.Trim())) { <small class="board-card__person-ref">Ref. @personKey[^keyLength..]</small> }
                                </span>
                            </dd>
                        </div>
                        <div class="board-card__activation"><dt>Activación</dt><dd>
                            <time datetime="@task.StartsAt.ToString("O")" title="@Model.Time(task.StartsAt)" aria-label="@activation.ToString("d 'de' MMMM 'de' yyyy, HH:mm", spanish)">
                                <span class="board-card__calendar" aria-hidden="true"><strong>@activation.Day</strong><span>@activation.ToString("MMM", spanish).TrimEnd('.')</span></span>
                                <span class="board-card__hour" aria-hidden="true">@activation.ToString("HH:mm")</span>
                            </time>
                        </dd></div>
                        <div class="board-card__load"><dt>Carga</dt><dd><strong>@task.LoadMinutes</strong><span>min</span></dd></div>
                    </dl>
                    @if (task.GoalUnits > 0) {
                        <div class="board-card__progress"><span>@task.ProgressUnits / @task.GoalUnits @task.ProgressUnit</span><progress value="@task.ProgressUnits" max="@task.GoalUnits" aria-label="Avance de @task.Name"></progress></div>
                    }
                </article>
            }
    </div>
    </div>
</div>

