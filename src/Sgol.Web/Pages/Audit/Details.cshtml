@page "/auditoria/eventos/{eventId:guid}"
@model Sgol.Web.Pages.Audit.DetailsModel
@using Sgol.Web.Presentation.Auditing
@{ ViewData["Title"] = "Evento de auditoría"; }
<header class="encabezado-pagina"><h1 class="encabezado-pagina__titulo" tabindex="-1">Evento de auditoría</h1></header>
@if (Model.Error is not null) { <div data-work-error tabindex="-1"><partial name="_ProblemAlert" model="Model.Error" /></div> }
@if (Model.Data is { } data)
{
    <section class="panel-seccion"><header class="panel-seccion__cabecera"><h2>@data.Action</h2></header><div class="evidencia__contenido">
    <dl><dt>ID del evento</dt><dd>@data.Id</dd><dt>Fecha y hora (UTC)</dt><dd>@data.OccurredAt.ToString("O")</dd><dt>Actor</dt><dd>@data.Actor.Type · @(data.Actor.UserId?.ToString("D") ?? "No informado")</dd><dt>Recurso</dt><dd>@data.Resource.Type · @(data.Resource.Id?.ToString("D") ?? "No informado") · @(data.Resource.BranchCode ?? "No informado")</dd><dt>Alcance</dt><dd>@(data.Scope.SubjectPersonId?.ToString("D") ?? "No informado") · @(data.Scope.SubjectLevel ?? "No informado") · @data.Scope.Relation · @(data.Scope.ObligationId?.ToString("D") ?? "No informado")</dd><dt>Resultado</dt><dd>@data.Outcome</dd><dt>Motivo registrado</dt><dd>@(data.Reason.Provided ? "Sí" : "No")</dd><dt>Correlación</dt><dd>@data.CorrelationId</dd></dl>
    <div class="tabla-contenedor"><table class="tabla"><caption>Cambios visibles</caption><thead class="tabla__encabezado"><tr><th scope="col">Campo</th><th scope="col">Antes</th><th scope="col">Después</th></tr></thead><tbody>
    @foreach (var key in (data.Change.Before?.Keys ?? []).Union(data.Change.After?.Keys ?? []).Order(StringComparer.Ordinal)) { <tr class="tabla__fila"><th scope="row">@key</th><td>@AuditPresentation.Display(data.Change.Before, key)</td><td>@AuditPresentation.Display(data.Change.After, key)</td></tr> }
    </tbody></table></div>
    @if ((data.Change.Before?.Count ?? 0) + (data.Change.After?.Count ?? 0) == 0) { <partial name="_EmptyState" model='@(new EmptyStateViewModel("Este evento no contiene cambios visibles en la proyección autorizada."))' /> }
    <p>Campos omitidos por protección de datos: @data.Change.OmittedFieldCount.</p>
    </div></section>
}
<a class="boton boton--secundario" href="@Model.ReturnHref">Regresar</a>
@section Scripts { <script src="~/js/my-work.js" asp-append-version="true"></script> }
