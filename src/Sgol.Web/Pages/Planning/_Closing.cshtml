@model Sgol.Web.Pages.Planning.IndexModel
@using Sgol.Web.Pages.People
@if(Model.CanPrepareDirectionPlan) {
<dialog id="closing-planning-dialog" class="modal closing-planning closing-planning-dialog" aria-labelledby="closing-planning-title" data-open-on-error="@(Model.ClosingError != null || Context.Request.Query.ContainsKey("closingFrom") || TempData.ContainsKey("ClosingSaved") ? "true" : null)">
    <div class="modal__contenido">
        <header class="closing-planning-dialog__header"><h2 id="closing-planning-title" class="modal__titulo">Cobertura de cierre</h2><button class="boton boton--secundario" type="button" data-dialog-close data-initial-focus>Cerrar</button></header>
        <p>Se propone a quien ya llega al cierre: 20:00 de lunes a sábado y 14:00 el domingo. Elegir a alguien extiende una hora su último tramo de esa fecha. No cambia sus permisos ni su capacidad.</p>
        <p>Horario operativo para terminar: hasta las 21:00; domingo hasta las 15:00. Las asignaciones ya creadas conservan sus fechas y responsables.</p>
        @if(TempData["ClosingSaved"] is string message) { <p class="alerta alerta--exito" role="status">@message</p> }
        @if(Model.ClosingError != null) { <p class="alerta alerta--error" role="alert" tabindex="-1" data-dialog-error>@Model.ClosingError</p> }
        <form method="get"><label class="campo"><span class="campo__etiqueta">Ver siete días desde</span><input class="campo__control" type="date" name="closingFrom" value="@Model.ClosingFrom.ToString("yyyy-MM-dd")" required /></label><button class="boton boton--secundario">Consultar cobertura</button></form>
        <div class="tabla-contenedor"><table class="tabla"><caption>Personas disponibles para cerrar</caption><thead><tr><th scope="col">Día</th><th scope="col">Responsable</th><th scope="col">Horario resultante</th><th scope="col">Elegir cobertura</th></tr></thead><tbody>
        @foreach(var row in Model.ClosingRows) {
            var selected=row.Candidates.FirstOrDefault(c=>c.PersonId==row.PersonId);
            <tr><th scope="row">@IndexModel.DayNames[(int)row.Day.DayOfWeek] @row.Day.ToString("dd/MM/yyyy")</th><td>@(selected?.Name ?? (row.PersonId == null ? "Sin cobertura" : "Cobertura no disponible"))</td><td>@row.Hours</td><td>
                <form method="post" asp-page-handler="Closing">
                    <input type="hidden" name="Closing.Day" value="@row.Day.ToString("yyyy-MM-dd")" /><input type="hidden" name="Closing.Revision" value="@row.Revision" /><input type="hidden" name="Closing.Key" value="@Guid.CreateVersion7()" />
                    <label class="campo"><span class="campo__etiqueta">Persona para @row.Day.ToString("dd/MM")</span><select class="campo__control" name="Closing.PersonId" required><option value="">Seleccionar persona</option>@foreach(var person in row.Candidates) { <option value="@person.PersonId" selected="@(person.PersonId==row.PersonId)">@person.Name · @person.Hours</option> }</select></label>
                    <button class="boton boton--secundario" disabled="@(row.Candidates.Length==0)">Guardar cobertura</button>
                </form>
            </td></tr>
        }
        </tbody></table></div>
    </div>
</dialog>
<link rel="stylesheet" href="~/css/personal-schedules.css" asp-append-version="true" />
}
