@page "/planificacion/procesos"
@model Sgol.Web.Pages.Planning.ProcessesModel
@using Sgol.Web.Pages.Tasks
@{ ViewData["Title"]="Plan de proceso"; }
<link rel="stylesheet" href="~/css/processes.css" asp-append-version="true" />
<section class="process-page planificacion planificacion--navigation" data-process-plan-page><header class="encabezado-pagina planificacion__navigation-header"><h1 class="encabezado-pagina__titulo">Plan de proceso</h1><partial name="_SectionNavigation" model='@("planning")' /></header>
@if(Model.Error!=null) { <p class="alerta alerta--peligro" role="alert">@Model.Error</p> }
@if(Model.Plan is { } plan)
{
    <div class="process-toolbar"><div><strong>@plan.Plan.Name</strong><small>@(plan.Plan.Status == "BORRADOR" ? "Plan preparado · siguiente paso: activar" : "Plan activado")</small></div><div class="process-actions">@if(Model.CanManage && plan.Plan.Status=="BORRADOR") { <button class="boton boton--primario" type="submit" form="process-plan-activate">Activar plan e iniciar el flujo</button> }<a class="boton boton--secundario" href="/planificacion">Volver a planificación</a></div></div>
    <section class="panel-seccion"><h2>Responsables del proceso</h2><p>@(plan.Plan.Status=="BORRADOR" ? "Preparado: carga reservada, sin tareas habilitadas" : "Activado: las etapas siguen su flujo")</p>
        <p>La versión seleccionada queda capturada al preparar el plan. Activarlo no habilita todas las etapas.</p>
        @foreach(var start in plan.Starts)
        {
            var captured=plan.Configurations.Single(c=>c.StartId==start.Id);
            <h3>@captured.Name · Versión @captured.Version</h3>
            <p>Inicio previsto @start.StartsAt.ToOffset(TimeSpan.FromHours(-6)).ToString("dd/MM/yyyy HH:mm") · Ciudad de México · @(start.Status=="PREPARADO" ? "Preparado" : "Activado")</p>
            <div class="process-flow process-plan-flow" data-process-plan-flow>@foreach(var stage in captured.Stages) { <article class="process-stage process-plan-card"><span class="process-position">Etapa @stage.Position</span><strong class="process-plan-task-name" title="@stage.Name">@stage.Name</strong><p>@IndexModel.RoleLabel(stage.Role) · @stage.Minutes min @(stage.IsEstimate ? "estimados hasta el conteo" : "de trabajo") @if(stage.OutputItem is {} item) { <span><br />Reporta @item.Name · tarifa capturada @item.Minutes min/unidad</span> }</p><strong>@stage.PersonName</strong><span class="process-flow-arrow" aria-hidden="true" data-process-flow-arrow>→</span></article> }</div>
        }
        @if(Model.CanManage && plan.Plan.Status=="BORRADOR") { <form id="process-plan-activate" method="post" asp-page-handler="Activate"><input type="hidden" name="planId" value="@plan.Plan.Id" /></form> }
        @foreach(var run in plan.Runs) { <p><a class="boton boton--secundario" href="/mi-trabajo/procesos?id=@run.Id">Abrir @run.Name · Ronda @run.Round</a></p> }
        @if(Model.CanManage && Model.Deletion is null)
        {
            <form method="post" asp-page-handler="PrepareDeletion"><input type="hidden" name="planId" value="@plan.Plan.Id" /><button class="boton boton--secundario" type="submit">Eliminar plan de proceso</button></form>
        }
    </section>
    @if(Model.Deletion is { } deletion && Model.DeleteIntent is not null)
    {
        <section class="panel-seccion" aria-labelledby="process-delete-title">
            <h2 id="process-delete-title">Eliminar el plan «@deletion.Name»</h2>
            <p>Esta acción es permanente. Se eliminará el plan para todos sus participantes:</p>
            <ul>
                <li>@deletion.Tasks tareas previstas, @deletion.Assignments asignaciones y @deletion.CompletedAssignments asignaciones terminadas.</li>
                <li>@plan.Runs.Length ejecuciones del proceso, con todas sus etapas, rondas, intentos, entregas y revisiones.</li>
                <li>@deletion.ProgressEntries registros de avance y @deletion.EvidenceFiles archivos: documentos de todas las versiones, fotografías y material de referencia.</li>
                <li>@deletion.CapacityAdjustments ajustes de capacidad del plan; se restablece la capacidad anterior registrada.</li>
            </ul>
            <p>Se liberará la carga pendiente. Se conservarán el proceso y sus tareas del catálogo, los trabajadores y la auditoría.</p>
            <form method="post" asp-page-handler="DownloadArchive">
                <input type="hidden" name="deleteIntent" value="@Model.DeleteIntent" />
                <button class="boton boton--secundario" type="submit">Descargar todos los archivos (ZIP)</button>
            </form>
            <p>El ZIP incluye los archivos originales y un índice del plan. Antes de eliminar, comprueba que la descarga terminó y el archivo se guardó. Si no hay archivos, contiene únicamente el índice.</p>
            <form method="post" asp-page-handler="Delete">
                <input type="hidden" name="deleteIntent" value="@Model.DeleteIntent" />
                <fieldset class="process-stage process-delete-choice"><legend>¿Quieres descargar los archivos antes de eliminar?</legend>
                    <label><input type="radio" name="archiveChoice" value="download" checked required /> Sí, descargar primero y conservar el ZIP</label>
                    <label><input type="radio" name="archiveChoice" value="skip" required /> No, eliminar sin descargar archivos</label>
                </fieldset>
                <label class="campo"><span class="campo__etiqueta">Escribe ELIMINAR para confirmar</span><input class="campo__control" name="confirmation" required pattern="ELIMINAR" autocomplete="off" /></label>
                <div class="process-actions"><a class="boton boton--secundario" href="/planificacion/procesos?planId=@plan.Plan.Id">Cancelar</a><button class="boton boton--primario" type="submit">Eliminar plan y sus archivos</button></div>
            </form>
        </section>
    }
}
else
{
    <details class="panel-seccion process-plan-settings" open="@(Model.Editor == null)"><summary>Seleccionar proceso @(Model.Editor?.Process.Name)</summary><form method="get"><label class="campo"><span class="campo__etiqueta">Proceso publicado y habilitado</span><select class="campo__control" name="processId" required><option value="">Selecciona</option>@foreach(var option in Model.Options) { <option value="@option.Id" selected="@(option.Id==Model.Input.ProcessId)">@option.Name</option> }</select></label><button class="boton boton--secundario" type="submit">Cargar etapas predefinidas</button></form></details>
    @if(Model.Editor is { } editor)
    {
        <div class="process-toolbar">
            <div><strong>@editor.Process.Name</strong><small data-process-plan-status>@(Model.Preview == null ? "1. Asignar responsables → 2. Revisar → 3. Guardar → 4. Activar" : "Fechas y capacidad verificadas · siguiente paso: guardar")</small></div>
            <div class="process-actions"><button class="boton @(Model.Preview == null ? "boton--primario" : "boton--secundario")" type="submit" form="process-plan-editor">Ver fechas y capacidad</button><button class="boton @(Model.Preview != null ? "boton--primario" : "boton--secundario")" type="submit" form="process-plan-prepare" data-process-plan-save disabled="@(Model.Preview == null)">Guardar plan preparado</button><a class="boton boton--secundario" href="/planificacion">Cerrar</a></div>
            <p data-process-plan-next>@(Model.Preview == null ? "Asigna cada tarea. Aleatorio prioriza menor ocupación entre personas compatibles y disponibles; sortea los empates." : "Revisa los responsables elegidos. Guardar reserva las etapas; activar es el siguiente paso.")</p>
        </div>
        <form id="process-plan-editor" method="post" asp-page-handler="Preview" data-process-plan-editor data-has-preview="@(Model.Preview != null ? "true" : "false")">
            <input type="hidden" asp-for="Input.Key" /><input type="hidden" asp-for="Input.ProcessId" />
            <details class="panel-seccion process-plan-settings" open="@(Model.Preview == null)"><summary>Nombre y fechas del plan · @Model.Input.Name</summary><div class="planificacion__formulario">
                <label class="campo"><span class="campo__etiqueta">Nombre del plan</span><input class="campo__control" asp-for="Input.Name" maxlength="120" required /></label>
                <label class="campo"><span class="campo__etiqueta">Tipo de inicio</span><select class="campo__control" asp-for="Input.Mode"><option value="CALENDARIO">Fechas del calendario del proceso</option><option value="OCASION">Ocasión explícita</option></select></label>
                <label class="campo"><span class="campo__etiqueta">Desde (inicio de la ocasión)</span><input class="campo__control" asp-for="Input.From" type="date" required /></label><label class="campo"><span class="campo__etiqueta">Hasta (periodo del calendario)</span><input class="campo__control" asp-for="Input.Through" type="date" required /></label>
            </div><p>La hora procede de la versión publicada. Si se activa después del inicio, el plazo comienza al habilitarse la etapa.</p></details>
            <section class="panel-seccion"><div class="process-section-heading"><div><h2>Responsables por tarea</h2><p>Lee de izquierda a derecha y continúa en la fila de abajo. Cada tarjeta muestra la carga de esa tarea.</p></div><button type="button" class="boton boton--secundario" data-process-plan-auto>Todos en Aleatorio</button></div>
            <div class="process-flow process-plan-flow" data-process-plan-flow>
            @foreach(var step in editor.Steps)
            {
                var task=editor.Tasks.Single(t=>t.Id==step.TaskId);
                <article class="process-stage process-plan-card"><span class="process-position">Etapa @step.Position</span><strong class="process-plan-task-name" title="@task.Name">@task.Name</strong><small>@IndexModel.RoleLabel(task.AssignedRole) · @task.LoadMinutes min de carga estimada · @IndexModel.Label(task.Requirement)</small>
                <label class="campo"><span class="campo__etiqueta">Responsable @(Model.Preview != null && Model.AutomaticPositions.Contains(step.Position) ? "· Aleatorio" : "")</span><select class="campo__control" name="Input.People[@step.Position]" data-process-plan-person required><option value="">Selecciona</option><option value="@Guid.Empty" selected="@(Model.Input.People.TryGetValue(step.Position,out var chosen) && chosen == Guid.Empty)">Aleatorio · según disponibilidad y carga</option>@foreach(var worker in Model.Workers.Where(w=>w.EligibleFor(task.AssignedRole, task.SpecializationId))) { <option value="@worker.Id" selected="@(Model.Input.People.GetValueOrDefault(step.Position)==worker.Id)">@worker.Name</option> }</select></label>
                <button type="button" class="boton boton--secundario" data-process-plan-detail-open>Ver instrucciones</button><dialog class="process-stage-dialog" aria-label="Instrucciones de @task.Name"><div class="process-section-heading"><h3>@task.Name</h3><button type="button" class="boton boton--secundario" data-process-plan-detail-close>Cerrar</button></div><p>@(string.IsNullOrWhiteSpace(step.Instructions) ? "Esta tarea no tiene instrucciones adicionales." : step.Instructions)</p></dialog>
                <span class="process-flow-arrow" aria-hidden="true" data-process-flow-arrow>→</span></article>
            }
            </div></section>
        </form>
        @if(Model.Preview is { } preview)
        {
            <section class="panel-seccion" data-process-plan-preview><h2>Revisar plan</h2><p>@preview.ProcessName · Versión @preview.Version · @preview.Stages.Sum(s=>s.Minutes) min estimados por ejecución</p>@foreach(var row in preview.Stages.Where(s=>s.OutputItem!=null)) { <p>Etapa @row.Position: @row.OutputItem!.Name · @row.OutputItem.Minutes min/unidad para la siguiente tarea.</p> }
            <ol>@foreach(var starts in preview.Starts) { <li>@starts.ToOffset(TimeSpan.FromHours(-6)).ToString("dd/MM/yyyy HH:mm") · Ciudad de México</li> }</ol>
            @if (preview.SchedulingPolicyId != null) { <details><summary>Ver agenda: activaciones y cierres por tarea</summary><div class="tabla-contenedor"><table class="tabla"><thead><tr><th>Tarea</th><th>Persona</th><th>Criticidad</th><th>Activación</th><th>Cierre</th></tr></thead><tbody>@foreach(var task in preview.Agenda.Values.SelectMany(a => a)) { <tr><td>@task.Name</td><td>@task.PersonName</td><td>@Sgol.Web.Infrastructure.Persistence.Planning.OperationalAgenda.Label(task.OperationalCriticality)</td><td>@task.StartsAt.ToOffset(TimeSpan.FromHours(-6)).ToString("dd/MM HH:mm")</td><td>@task.DueAt.ToOffset(TimeSpan.FromHours(-6)).ToString("dd/MM HH:mm")</td></tr> }</tbody></table></div></details> }
            <p>Los responsables verificados se muestran en las tarjetas de arriba. Si cambias el plan, vuelve a revisar fechas y capacidad.</p>
            <form id="process-plan-prepare" method="post" asp-page-handler="Prepare"><input type="hidden" asp-for="Input.Key" /><input type="hidden" asp-for="Input.ProcessId" /><input type="hidden" asp-for="Input.Name" /><input type="hidden" asp-for="Input.Mode" /><input type="hidden" asp-for="Input.From" /><input type="hidden" asp-for="Input.Through" /><input type="hidden" asp-for="Input.Fingerprint" />@foreach(var person in Model.Input.People) { <input type="hidden" name="Input.People[@person.Key]" value="@person.Value" /> }
                <p>Guardar reserva todas las etapas. Todavía no crea asignaciones ni habilita trabajo.</p>
            </form></section>
        }
    }
}
</section>

@section Scripts {
    <script src="~/js/process-plan.js" asp-append-version="true"></script>
}
