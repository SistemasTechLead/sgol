@page "/reportes"
@model Sgol.Web.Pages.Reports.IndexModel
@using Sgol.Web.Infrastructure.Persistence.Reporting
@using System.Globalization
@{
    ViewData["Title"] = "Reportes";
    var options = Model.Options;
}
@section Scripts {
    <script src="~/vendor/jspdf/jspdf.umd.min.js" asp-append-version="true" defer></script>
    <script src="~/js/reports.js" asp-append-version="true" defer></script>
}
<link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />
<header class="encabezado-pagina report-heading">
    <div class="encabezado-pagina__contenido"><h1 class="encabezado-pagina__titulo">Reportes</h1><p class="encabezado-pagina__descripcion">Entiende la operación, encuentra pendientes y comparte los resultados.</p></div>
    <div class="report-actions"><button type="button" class="boton boton--secundario" data-report-save>@(Model.EditingName != null ? "Guardar cambios en plantilla" : "Guardar como plantilla")</button><button type="button" class="boton boton--primario" data-report-export disabled="@(Model.Error != null)"><partial name="_Icon" model='@("report")' />Exportar a PDF</button></div>
</header>
@if (Model.Success != null) { <p class="report-message" role="status">@Model.Success</p> }
@if (Model.Error != null) { <p class="report-message report-message--error" role="alert">@Model.Error</p> }
<section class="panel-seccion report-controls" aria-label="Configuración del reporte">
    <div class="report-template-picker">
        <label class="campo"><span class="campo__etiqueta">Plantillas predefinidas y personales</span><select class="campo__control" id="report-template"><option value="">Personalizar configuración</option><optgroup label="Predefinidas">@foreach (var definition in ReportCatalog.Definitions) { <option value="preset:@definition.Id" selected="@(Model.AppliedTemplate == "preset:" + definition.Id)" data-configuration="@System.Text.Json.JsonSerializer.Serialize(ReportCatalog.Preset(definition.Id), Sgol.Web.Pages.Reports.IndexModel.JsonOptions)">@definition.Name · semana actual</option> }</optgroup><optgroup label="Mis plantillas">@foreach (var template in Model.Templates) { <option value="@template.Id" selected="@(Model.AppliedTemplate == template.Id.ToString())" data-configuration="@template.Configuration">@template.Name</option> }</optgroup></select></label>
        <button class="boton boton--secundario" type="button" id="report-apply-template">Aplicar plantilla</button>
        <button class="boton boton--textual" type="button" id="report-edit-template" disabled>Editar</button>
        <button class="boton boton--textual" type="button" id="report-duplicate-template" disabled>Duplicar</button>
        <button class="boton boton--textual" type="button" id="report-delete-template" disabled>Eliminar</button>
    </div>
    <form method="get" id="report-filters" data-configuration="@Model.FilterJson" data-editing-name="@Model.EditingName">
        <div class="report-filter-grid">
            <label class="campo"><span class="campo__etiqueta">Tipo de reporte</span><select asp-for="F.Kind" class="campo__control">@foreach (var definition in ReportCatalog.Definitions) { <option value="@definition.Id">@definition.Name</option> }</select></label>
            <label class="campo"><span class="campo__etiqueta">Periodo</span><select asp-for="F.Range" class="campo__control"><option value="week">Semana actual</option><option value="last-week">Semana anterior</option><option value="month">Mes actual</option><option value="last-month">Mes anterior</option><option value="quarter">Trimestre actual</option><option value="semester">Semestre actual</option><option value="year">Año actual</option><option value="custom">Fechas específicas</option></select></label>
            <label class="campo"><span class="campo__etiqueta">Fecha de referencia</span><select asp-for="F.DateBasis" class="campo__control"><option value="start">Inicio de la tarea</option><option value="due">Vencimiento</option><option value="delivered">Entrega a revisión</option><option value="reviewed">Revisión del supervisor</option></select></label>
            <label class="campo"><span class="campo__etiqueta">Responsable</span><select asp-for="F.Person" class="campo__control"><option value="">Todos los disponibles</option>@foreach (var row in options.DistinctBy(r => r.PersonId).OrderBy(r => r.Person)) { <option value="@row.PersonId">@row.Person</option> }</select></label>
            <label class="campo"><span class="campo__etiqueta">Rol</span><select asp-for="F.Role" class="campo__control"><option value="">Todos los disponibles</option>@foreach (var role in options.Select(r => r.Role).Distinct().Order()) { <option value="@role">@ReportCatalog.RoleName(role)</option> }</select></label>
            <label class="campo"><span class="campo__etiqueta">Plan</span><select asp-for="F.Plan" class="campo__control"><option value="">Todos los disponibles</option>@foreach (var row in options.DistinctBy(r => r.PlanId).OrderBy(r => r.Plan)) { <option value="@row.PlanId">@row.Plan</option> }</select></label>
        </div>
        <div class="report-filter-grid" id="report-custom-dates" hidden="@(Model.F.Range != "custom")"><label class="campo"><span class="campo__etiqueta">Desde</span><input asp-for="F.From" type="date" class="campo__control" /></label><label class="campo"><span class="campo__etiqueta">Hasta</span><input asp-for="F.To" type="date" class="campo__control" /></label><p>Consulta hasta 366 días por reporte.</p></div>
        <details class="report-advanced"><summary>Más filtros y presentación</summary><div class="report-filter-grid">
            <label class="campo"><span class="campo__etiqueta">Arrastre / puntualidad</span><select asp-for="F.Carryover" class="campo__control"><option value="">Todos</option><option value="approved">Con arrastre autorizado</option><option value="covered">Tardías cubiertas por arrastre</option><option value="pending">Solicitud pendiente</option><option value="late">Entrega fuera de plazo</option></select></label>
            <label class="campo"><span class="campo__etiqueta">Estado</span><select asp-for="F.Status" class="campo__control"><option value="">Todos</option>@foreach (var state in ReportCatalog.Statuses) { <option value="@state.Key">@state.Value</option> }</select></label>
            <label class="campo"><span class="campo__etiqueta">Tarea</span><select asp-for="F.Task" class="campo__control"><option value="">Todas</option>@foreach (var row in options.DistinctBy(r => r.Code).OrderBy(r => r.Task)) { <option value="@row.Code">@row.Task</option> }</select></label>
            <label class="campo"><span class="campo__etiqueta">Área del plan</span><select asp-for="F.Area" class="campo__control"><option value="">Todas</option>@foreach (var area in options.Select(r => r.Area).Distinct().Order()) { <option value="@area">@area</option> }</select></label>
            <label class="campo"><span class="campo__etiqueta">Especialización</span><select asp-for="F.Specialization" class="campo__control"><option value="">Todas</option>@foreach (var specialization in options.Select(r => r.Specialization).Where(s => s.Length > 0).Distinct().Order()) { <option value="@specialization">@specialization</option> }</select></label>
            <label class="campo"><span class="campo__etiqueta">Evidencia requerida</span><select asp-for="F.Requirement" class="campo__control"><option value="">Todas</option><option value="FOTOGRAFIA">Fotografía</option><option value="DOCUMENTO">Documento</option><option value="COMENTARIO">Comentario</option><option value="CHECKLIST">Checklist</option><option value="NINGUNO">Ninguna</option></select></label>
            <label class="campo"><span class="campo__etiqueta">Programación</span><select asp-for="F.Schedule" class="campo__control"><option value="">Todas</option><option value="DISTRIBUIDA">Distribuida</option><option value="DIAS_FIJOS">Días fijos</option><option value="PROGRESO">Por progreso</option></select></label>
            <label class="campo"><span class="campo__etiqueta">Frecuencia</span><select asp-for="F.Frequency" class="campo__control"><option value="">Todas</option><option value="SEMANAL">Semanal</option><option value="MENSUAL">Mensual</option><option value="TRIMESTRAL">Trimestral</option><option value="ANUAL">Anual</option></select></label>
            <label class="campo"><span class="campo__etiqueta">Repeticiones por periodo</span><input asp-for="F.Repetitions" type="number" min="1" max="100" class="campo__control" /></label>
            <label class="campo"><span class="campo__etiqueta">Plazo en horas</span><input asp-for="F.Hours" type="number" min="1" max="8760" class="campo__control" /></label>
            <label class="campo"><span class="campo__etiqueta">Carga estimada en minutos</span><input asp-for="F.Minutes" type="number" min="1" max="4800" class="campo__control" /></label>
            <label class="campo"><span class="campo__etiqueta">Avance mínimo (%)</span><input asp-for="F.ProgressMin" type="number" min="0" max="100" class="campo__control" /></label>
            <label class="campo"><span class="campo__etiqueta">Avance máximo (%)</span><input asp-for="F.ProgressMax" type="number" min="0" max="100" class="campo__control" /></label>
            <label class="campo"><span class="campo__etiqueta">Agrupar por</span><select asp-for="F.Group" class="campo__control"><option value="person">Responsable</option><option value="plan">Plan</option><option value="role">Rol</option><option value="task">Tarea</option></select></label>
            <label class="campo"><span class="campo__etiqueta">Orden del detalle</span><select asp-for="F.Order" class="campo__control"><option value="due">Vencimiento más próximo</option><option value="person">Responsable</option><option value="progress">Menor avance</option><option value="delay">Mayor antigüedad</option></select></label>
        </div><fieldset class="report-column-picker"><legend>Columnas del detalle y del PDF</legend>@foreach (var column in ReportCatalog.Columns) { <label><input type="checkbox" data-report-column value="@column.Key" checked="@(Model.SelectedColumns.Contains(column.Key))" />@column.Value</label> }</fieldset></details>
        <input asp-for="F.Columns" type="hidden" /><input asp-for="EditingTemplate" type="hidden" /><input asp-for="AppliedTemplate" type="hidden" />
        <div class="report-actions"><button type="submit" class="boton boton--primario"><partial name="_Icon" model='@("filter")' />Generar reporte</button><a href="/reportes" class="boton boton--textual">Restablecer filtros</a><span id="report-dirty" hidden>Hay cambios en los filtros. Genera el reporte para aplicarlos.</span></div>
    </form>
</section>
@if (Model.Error == null) {
    <section class="report-result" aria-labelledby="report-title" id="report-result">
        <header class="report-result-heading"><div><span class="report-eyebrow">LORETTA · GESTIÓN OPERATIVA</span><h2 id="report-title">@Model.Definition.Name</h2><p>@Model.Definition.Description</p></div><div class="report-period"><strong>@Model.From.ToString("dd/MM/yyyy") — @Model.Through.ToString("dd/MM/yyyy")</strong><span>Corte: @ReportCatalog.Time(Model.Cutoff) · Ciudad de México</span><span>@Model.Scope</span></div></header>
        <p class="report-filter-summary">@Model.FilterSummary()</p>
        <div class="report-metrics">@foreach (var metric in Model.Metrics) { <button type="button" class="report-metric report-tone--@metric.Tone" data-report-status="@metric.Status" disabled="@(metric.Status == null)"><span>@metric.Label</span><strong>@metric.Value</strong><small>@metric.Hint</small></button> }</div>
        @if (Model.Rows.Length == 0) { <div class="report-empty"><partial name="_Icon" model='@("report")' /><h3>No hay tareas para esta consulta</h3><p>Prueba otro periodo o ajusta los filtros. También puedes exportar este resultado.</p></div> }
        else {
            <div class="report-charts">@foreach (var chart in Model.Charts) {
                var max = chart.Unit == "%" ? 100m : Math.Max(1, chart.Points.Select(p => Math.Max(p.Value, p.Capacity ?? 0)).DefaultIfEmpty(1).Max());
                <section class="panel-seccion report-chart"><header><h3>@chart.Title</h3><span>@chart.Unit</span></header><div class="report-chart-scroll">@foreach (var point in chart.Points) {
                    var statusKey = ReportCatalog.Statuses.ContainsKey(point.Key ?? "") ? point.Key : null;
                    var groupKey = chart.Title.EndsWith("grupo") || chart.Title == "Carga pendiente y capacidad" ? point.Key : null;
                    <button type="button" class="report-bar-row" data-report-status="@statusKey" data-report-group="@groupKey" disabled="@(statusKey == null && groupKey == null)"><span class="report-bar-label">@point.Label</span>@if (point.Segments != null) { var segmentX = 0m; <svg class="report-stacked" viewBox="0 0 100 3" preserveAspectRatio="none" role="img" aria-label="@point.Caption">@foreach (var segment in point.Segments) { <rect class="report-tone--@segment.Tone" x="@segmentX.ToString(CultureInfo.InvariantCulture)" y="0" width="@segment.Value.ToString(CultureInfo.InvariantCulture)" height="3"><title>@segment.Label: @segment.Value.ToString("0.#") %</title></rect> segmentX += segment.Value; }</svg> } else { <progress class="report-progress report-tone--@(statusKey != null ? ReportCatalog.Tone(statusKey) : chart.Tone)" value="@point.Value.ToString(CultureInfo.InvariantCulture)" max="@max.ToString(CultureInfo.InvariantCulture)" aria-label="@point.Label"></progress> }@if (point.Capacity != null) { <progress class="report-progress report-capacity" value="@point.Capacity.Value.ToString(CultureInfo.InvariantCulture)" max="@max.ToString(CultureInfo.InvariantCulture)" aria-label="Capacidad disponible"></progress> }<small>@point.Caption</small></button>
                }</div>@if (chart.Points.Any(p => p.Segments != null)) { <p class="report-caption">Barras apiladas: verde, concluidas; rojo, vencidas o no satisfechas; ámbar, por revisar; azul, asignadas o programadas. Cada segmento indica su estado y porcentaje al consultarlo.</p> }@if (chart.Points.Count == 0) { <p>Sin registros para esta gráfica.</p> }@if (chart.Unit == "minutos estimados") { <p class="report-caption">Azul: carga restante de las tareas filtradas. Arena: capacidad configurada del periodo. No representa tiempo real trabajado.</p> }</section>
            }</div>
        }
        <section class="panel-seccion report-detail"><header class="report-detail-heading"><div><h3>Detalle del reporte</h3><p>@Model.TotalRows asignaciones · Los intentos reasignados se muestran por separado en los indicadores.</p></div><form method="get">
                @foreach(var query in Request.Query.Where(q => q.Key is not ("DetailSearch" or "PageNumber" or "handler"))) { <input type="hidden" name="@query.Key" value="@query.Value" /> }
                <label class="campo"><span class="campo__etiqueta">Buscar en todo el detalle</span><input name="DetailSearch" value="@Model.DetailSearch" type="search" class="campo__control" id="report-search" placeholder="Tarea, responsable, plan…" /></label><button type="submit" class="boton boton--secundario">Buscar</button></form></header>
            @if (Model.Pagination is {} pagination) { <partial name="_ListPage" model="pagination" /> }
            <div class="report-table-scroll"><table class="report-table"><thead><tr>@foreach (var column in Model.SelectedColumns) { <th scope="col">@ReportCatalog.Columns[column]</th> }</tr></thead><tbody>@foreach (var row in Model.Rows) { <tr>@foreach (var column in Model.SelectedColumns) { <td>@if (column == "status") { <span class="report-status report-tone--@ReportCatalog.Tone(row.Status)">@ReportCatalog.Cell(row, column)</span> } else if (column == "progress" && row.Goal > 0) { <span>@ReportCatalog.Cell(row, column)</span><progress class="report-progress report-tone--success" value="@row.Progress.ToString(CultureInfo.InvariantCulture)" max="100" aria-label="Avance de @row.Task"></progress> } else { @ReportCatalog.Cell(row, column) }</td> }</tr> }</tbody></table></div><p id="report-search-count" class="report-caption" aria-live="polite"></p>
        </section>
        <p class="report-caption">Estado actual al corte de consulta, incluso para periodos anteriores. Entregar una tarea no equivale a aprobarla. Los minutos representan carga estimada.</p>
    </section>
}
<dialog id="report-save-dialog" class="report-dialog"><form method="post" asp-page-handler="Save" id="report-save-form"><h2 id="report-save-title">Guardar plantilla personal</h2><p>Conserva los filtros y la presentación. Los periodos relativos se actualizan cada vez que la uses.</p><label class="campo"><span class="campo__etiqueta">Nombre de la plantilla</span><input asp-for="TemplateName" class="campo__control" required maxlength="100" /></label><input asp-for="Configuration" type="hidden" /><input asp-for="TemplateId" type="hidden" /><div class="report-actions"><button class="boton boton--primario" type="submit">Guardar plantilla</button><button class="boton boton--textual" type="button" data-report-close>Cancelar</button></div></form></dialog>
<dialog id="report-delete-dialog" class="report-dialog"><form method="post" asp-page-handler="Delete" id="report-delete-form"><h2>Eliminar plantilla</h2><p id="report-delete-name"></p><p>Podrás crear una nueva configuración cuando quieras.</p><input name="TemplateId" type="hidden" /><div class="report-actions"><button class="boton boton--primario" type="submit">Eliminar</button><button class="boton boton--textual" type="button" data-report-close>Cancelar</button></div></form></dialog>
<dialog id="report-pdf-dialog" class="report-dialog report-dialog--pdf"><header><h2>Exportar a PDF</h2><button type="button" class="boton boton--textual" data-report-close>Cerrar</button></header><p>El documento incluye el reporte generado y su logo. La búsqueda del detalle no modifica la exportación.</p><div class="report-actions"><label class="campo"><span class="campo__etiqueta">Contenido</span><select id="report-pdf-mode" class="campo__control"><option value="summary">Resumen visual</option><option value="full">Reporte completo con detalle</option></select></label><button class="boton boton--secundario" type="button" id="report-preview">Ver vista previa</button><button class="boton boton--primario" type="button" id="report-download" disabled>Descargar PDF</button></div><p id="report-pdf-status" role="status"></p><iframe id="report-pdf-preview" title="Vista previa del reporte en PDF" hidden></iframe></dialog>


