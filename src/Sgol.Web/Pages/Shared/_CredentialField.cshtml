@model CredentialFieldViewModel
@{
    var hasError = !string.IsNullOrWhiteSpace(Model.ErrorMessage);
    var errorId = $"{Model.Id}-error";
    var fieldClass = hasError ? "campo campo--error" : "campo";
    var autocomplete = Model.Kind switch
    {
        CredentialKind.Password => "current-password",
        CredentialKind.OneTimeCode => "one-time-code",
        _ => "off",
    };
    var inputMode = Model.Kind == CredentialKind.OneTimeCode ? "numeric" : "text";
}
<div class="@fieldClass">
    <label class="campo__etiqueta" for="@Model.Id">@Model.Label</label>
    <div class="campo-credencial">
        <input id="@Model.Id"
               name="@Model.Id"
               class="campo__control"
               type="password"
               autocomplete="@autocomplete"
               inputmode="@inputMode"
               autocapitalize="none"
               spellcheck="false"
               disabled="@Model.IsDisabled"
               aria-invalid="@hasError.ToString().ToLowerInvariant()"
               aria-describedby="@(hasError ? errorId : null)" />
        @if (Model.CanReveal)
        {
            <button class="boton boton--secundario campo-credencial__alternar"
                    type="button"
                    data-credential-toggle
                    aria-controls="@Model.Id"
                    aria-pressed="false">
                Mostrar
            </button>
        }
    </div>
    @if (hasError)
    {
        <span id="@errorId" class="campo__mensaje-error">
            <span aria-hidden="true">!</span>
            @Model.ErrorMessage
        </span>
    }
</div>
