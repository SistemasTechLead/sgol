@model StatusBadgeViewModel
<span class="badge badge--@Model.Style">
    <span class="badge__icono" aria-hidden="true">@if (Model.Icon is "◷" or "✓" or "▦" or "ⓘ" or "◷!" or "●✓" or "△")
        { <partial name="_Icon" model='@(Model.Icon switch { "◷" => "clock", "✓" or "●✓" => "check", "▦" => "calendar", "◷!" or "△" => "alert", _ => "info" })' /> }
        else { @Model.Icon }</span>
    @Model.Text
</span>
