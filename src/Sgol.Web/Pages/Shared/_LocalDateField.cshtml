@model LocalDateFieldViewModel
@{
    var hasError = !string.IsNullOrWhiteSpace(Model.ErrorMessage);
    var errorId = $"{Model.Id}-error";
    var zoneId = $"{Model.Id}-zone";
    var describedBy = hasError ? $"{zoneId} {errorId}" : zoneId;
    var type = Model.Kind == LocalDateFieldKind.Date ? "date" : "datetime-local";
}
<label class="@(hasError ? "campo campo--error" : "campo")" for="@Model.Id">
    <span class="campo__etiqueta">@Model.Label</span>
    <input id="@Model.Id"
           name="@Model.Id"
           class="campo__control"
           type="@type"
           value="@Model.Value"
           disabled="@Model.IsDisabled"
           aria-invalid="@hasError.ToString().ToLowerInvariant()"
           aria-describedby="@describedBy" />
    <span id="@zoneId" class="campo__ayuda">Zona operativa: @Model.TimeZoneLabel</span>
    @if (hasError)
    {
        <span id="@errorId" class="campo__mensaje-error"><span aria-hidden="true">!</span> @Model.ErrorMessage</span>
    }
</label>
