@inject Sgol.Web.Presentation.Navigation.IRazorSessionState SessionState
@inject Sgol.Web.Presentation.Authentication.RazorAntiforgeryBridge AntiforgeryBridge
@{
    var title = ViewData["Title"] as string ?? "SGOL";
    var navigationItems = new[]
    {
        new NavigationItem("Personas y accesos", "/personas-y-accesos",
            new HashSet<string>(["DIRECCION"], StringComparer.Ordinal),
            new HashSet<string>(["PER-PERSONA-ADMIN"], StringComparer.Ordinal)),
        new NavigationItem("Configuración", "/configuracion",
            new HashSet<string>(["DIRECCION"], StringComparer.Ordinal),
            new HashSet<string>(["PER-CONFIG-ADMIN"], StringComparer.Ordinal))
    };
    var shell = Context.Request.Path.StartsWithSegments("/mi-trabajo") ||
        Context.Request.Path.StartsWithSegments("/personas-y-accesos") ||
        Context.Request.Path.StartsWithSegments("/configuracion");
    var session = shell ? await SessionState.GetAsync(Context.RequestAborted) : null;
    var roleName = session is null ? null : SessionPresentation.RoleName(session.RoleCode);
    if (roleName is null) session = null;
    var visibleItems = RoleAwareNavigation.VisibleTo(session, navigationItems);
    var hasNavigation = visibleItems.Count > 0;
    var expiration = session is null ? (DateTimeOffset?)null : SessionPresentation.EffectiveExpiration(session);
}
<!DOCTYPE html>
<html lang="es-MX">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title — SGOL</title>
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
</head>
<body>
    <a class="salto-contenido" href="#contenido-principal">Saltar al contenido principal</a>
    <div class="aplicacion @(!shell ? "aplicacion--acceso" : !hasNavigation ? "aplicacion--sin-navegacion" : null)">
        <header class="encabezado-aplicacion">
            <span class="encabezado-aplicacion__marca" aria-label="Sistema de Gestión Operativa Loretta">SGOL</span>
            @if (session is not null)
            {
                <div class="encabezado-aplicacion__identidad">
                    <span class="encabezado-aplicacion__sesion">@session.DisplayName</span>
                    <span class="encabezado-aplicacion__rol">@roleName</span>
                    <span class="encabezado-aplicacion__expiracion">Sesión hasta
                        <time datetime="@expiration!.Value.ToString("O")">@SessionPresentation.ExpirationText(session, DateTimeOffset.UtcNow)</time>
                        (hora de Ciudad de México)
                    </span>
                </div>
                <form method="post" action="/mi-trabajo" asp-antiforgery="false" class="encabezado-aplicacion__logout" data-logout-form>
                    <input type="hidden" name="__RequestVerificationToken" value="@AntiforgeryBridge.Issue(Context)" />
                    <button class="boton boton--secundario" type="submit">Cerrar sesión</button>
                </form>
                @if (hasNavigation)
                {
                    <button class="boton boton--secundario navegacion-movil__abrir" type="button"
                            data-dialog-open aria-controls="navegacion-movil">Navegación principal</button>
                }
            }
        </header>
        @if (hasNavigation)
        {
        <aside class="barra-lateral">
            <nav class="navegacion-lateral navegacion-lateral--escritorio" aria-label="Navegación principal">
                <ul class="navegacion-lateral__lista">
                    @foreach (var item in visibleItems)
                    {
                        <li>
                            <a class="navegacion-lateral__item"
                               href="@item.Href"
                               aria-current="@(Context.Request.Path.StartsWithSegments(item.Href) ? "page" : null)">
                                @item.Label
                            </a>
                        </li>
                    }
                </ul>
            </nav>
                <dialog id="navegacion-movil" class="navegacion-movil" aria-label="Navegación principal">
                    <form method="dialog"><button class="boton boton--secundario" type="submit">Cerrar navegación</button></form>
                    <nav aria-label="Navegación principal móvil">
                        <ul class="navegacion-lateral__lista">
                            @foreach (var item in visibleItems)
                            {
                                <li><a class="navegacion-lateral__item" href="@item.Href"
                                       aria-current="@(Context.Request.Path.StartsWithSegments(item.Href) ? "page" : null)">@item.Label</a></li>
                            }
                        </ul>
                    </nav>
                </dialog>
        </aside>
        }
        <main id="contenido-principal" class="contenido-principal" tabindex="-1">
            @RenderBody()
        </main>
    </div>
    <script src="~/js/components.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
