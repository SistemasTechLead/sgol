@page "/tareas"
@model Sgol.Web.Pages.Tasks.IndexModel
@using Sgol.Web.Pages.Tasks
@using Sgol.Web.Infrastructure.Persistence.Planning
@{ ViewData["Title"] = "Tareas";
    var showSundayTime = Model.Input.PeriodType == "SEMANAL" && (Model.Input.ScheduleMode == "DIAS_FIJOS" && Model.InputDays.Contains(0) || Model.Input.ScheduleMode == "DISTRIBUIDA" && Model.Input.Repetitions == 7);
}
<link rel="stylesheet" href="~/css/task-actions.css" asp-append-version="true" />
<section aria-labelledby="tasks-title" data-task-catalog>
    <header class="encabezado-pagina encabezado-pagina--catalogo">
        <div class="encabezado-pagina__contenido">
            <h1 id="tasks-title" class="encabezado-pagina__titulo">Tareas</h1>
            <p class="encabezado-pagina__descripcion">Consulta las tareas, sus requisitos y el proceso al que pertenecen.</p>
        </div>
        <div class="tasks-header-actions">
            <partial name="_SectionNavigation" model='@("tasks")' />
            @if (Model.CanManage)
            {
                <form method="get" asp-page="Refresh" class="tasks-global-refresh">
                    <button class="boton boton--primario" type="submit" disabled="@(Model.RefreshCounts.Count == 0)" aria-describedby="global-refresh-status">Actualizar Asignaciones</button>
                </form>
            }
        </div>
    </header>
    @if (Model.CanManage) { <p id="global-refresh-status" role="status">@(Model.RefreshCounts.Count > 0 ? $"En todo el catálogo: {Model.RefreshCounts.Values.Sum()} asignaciones pendientes con diferencias en {Model.RefreshCounts.Count} tareas. Revisa y actualiza todas juntas." : "Todas las asignaciones pendientes están actualizadas.")</p> }
    @if (!Model.CanManage) { <p>Consulta el catálogo de tareas. Dirección administra sus cambios.</p> }
    <form method="get" class="tasks-search"><label class="campo"><span class="campo__etiqueta">Buscar tareas</span><input class="campo__control" type="search" name="Search" value="@Model.Search" placeholder="Nombre o código de tarea" /></label><label class="campo"><span class="campo__etiqueta">Proceso</span><select class="campo__control" asp-for="ProcessFilter"><option value="">Todos</option>@foreach(var process in Model.Processes) { <option value="@process.Id">@process.Name</option> }</select></label><button class="boton boton--secundario" type="submit">Buscar</button></form>
    @if (TempData["AssignmentsUpdated"] is string updated) { <p class="alerta" role="status">@updated</p> }
    @if (Model.Error is not null) { <p class="alerta alerta--peligro" role="alert">@Model.Error</p> }
    @if (Model.CanManage && Model.AdjustClosure)
    {
        <section class="panel-seccion" aria-labelledby="closure-title"><h2 id="closure-title">Ajustar Porcentaje Para el Cierre</h2>
            <p>Vigente: @(Model.SchedulingPolicy?.MarginPercent)% · versión @Model.SchedulingPolicy?.Revision. Se aplica a nuevos planes y asignaciones independientes. Los compromisos publicados conservan sus fechas y su política.</p>
            <p>Con 50%, una carga de 20 minutos reserva 30 minutos hasta el cierre. El margen también ocupa espacio en la agenda; no aumenta la carga registrada.</p>
            <form method="post" asp-page-handler="Closure"><input type="hidden" asp-for="PolicyRevision" /><label class="campo"><span class="campo__etiqueta">Margen global (%)</span><input class="campo__control" asp-for="ClosureMarginPercent" type="number" min="0" max="500" required /></label><p>Confirmar este cambio no recalcula asignaciones existentes.</p><button class="boton boton--primario" type="submit">Confirmar porcentaje para nuevas operaciones</button><a class="boton boton--secundario" href="/tareas">Cancelar</a></form>
        </section>
    }
    @if (Model.Editing)
    {
        <link rel="stylesheet" href="~/css/task-form.css" asp-append-version="true" />
        <section class="panel-seccion tasks-editor task-form" aria-labelledby="task-edit-title">
            <header class="panel-seccion__cabecera"><h2 id="task-edit-title">@(Model.Input.Revision == 0 ? "Crear Tarea" : "Editar tarea")</h2></header>
            <form method="post" asp-page-handler="Save">
                <input type="hidden" asp-for="Input.Id" /><input type="hidden" asp-for="Input.Revision" />
                <input type="hidden" asp-for="ReturnProcess" />
                <section class="task-form__section" aria-labelledby="task-data-title">
                    <h3 id="task-data-title">Datos de la tarea</h3>
                    <div class="task-form__grid">
                        <label class="campo task-form__wide"><span class="campo__etiqueta">Nombre</span><input class="campo__control" asp-for="Input.Name" maxlength="500" required /></label>
                        <label class="campo task-form__wide"><span class="campo__etiqueta">Descripción (opcional)</span><textarea class="campo__control" asp-for="Input.Description" maxlength="4000" rows="5" aria-describedby="task-description-help"></textarea><small id="task-description-help" class="task-form__help">Explica qué se debe hacer. Hasta 4,000 caracteres. Aplica a todos los tipos de tareas; las nuevas asignaciones conservarán esta descripción.</small></label>
                        <label class="campo task-form__wide"><span class="campo__etiqueta">Proceso</span><select class="campo__control" asp-for="Input.ProcessId" data-task-process data-general-id="@OperationalSequence.GeneralId">@foreach(var process in Model.Processes) { <option value="@process.Id">@process.Name</option> }</select><small class="task-form__help">Para mover una tarea existente, usa el editor del proceso. Una tarea nueva dentro de un proceso queda pendiente de añadir y publicar su etapa.</small></label>
                        <p class="task-form__note task-form__wide" data-process-help hidden="@(Model.Input.ProcessId == OperationalSequence.GeneralId)">El proceso controla inicio y plazo. Los calendarios individuales anteriores se conservan y no generan esta tarea. <a href="/tareas/procesos?id=@Model.Input.ProcessId">Ver reglas del proceso</a></p>
                        <label class="campo"><span class="campo__etiqueta">Rol asignado</span><select class="campo__control" asp-for="Input.AssignedRole" required>@foreach (var role in OperationalSchedule.Roles) { <option value="@role">@IndexModel.RoleLabel(role)</option> }</select></label>
                        <div class="task-form__specialization">
                            <label class="task-form__check"><input asp-for="RequiresSpecialization" data-requires-specialization aria-controls="task-specialization" /><span>Requiere especialización</span></label>
                            <label id="task-specialization" class="campo" hidden="@(!Model.RequiresSpecialization)"><span class="campo__etiqueta">Especialización requerida</span><select class="campo__control" asp-for="Input.SpecializationId" data-specialization-select><option value="">Selecciona una especialización</option>@foreach (var specialty in Model.Specializations) { <option value="@specialty.Id">@specialty.Name</option> }</select><small class="task-form__help">Pueden recibirla personas de cualquier rol con esta especialización y fuera del periodo A prueba.</small></label>
                        </div>
                    </div>
                </section>
                <section class="task-form__section" aria-labelledby="task-evidence-title">
                    <h3 id="task-evidence-title">Evidencia para terminar</h3>
                    <label class="campo"><span class="campo__etiqueta">Requisito para terminar</span><select class="campo__control" asp-for="Input.Requirement">@foreach (var code in OperationalSchedule.Requirements) { <option value="@code">@IndexModel.Label(code)</option> }</select></label>
                    <fieldset class="task-form__group" data-photo-limits><legend>Límites de fotografías o capturas para nuevas asignaciones</legend>
                        <div class="task-form__grid">
                            <label class="campo task-form__number"><span class="campo__etiqueta">Mínimo de imágenes</span><input class="campo__control" asp-for="Input.MinimumPhotos" type="number" min="1" max="20" required /></label>
                            <label class="campo task-form__number"><span class="campo__etiqueta">Máximo de imágenes</span><input class="campo__control" asp-for="Input.MaximumPhotos" type="number" min="1" max="20" required /></label>
                        </div>
                        <input type="hidden" asp-for="Input.MaximumPhotoBytes" /><small class="task-form__help">Hasta 15 MiB por imagen y 30 MiB en total. Las asignaciones existentes conservan sus límites.</small>
                    </fieldset>
                </section>
                <section class="task-form__section" aria-labelledby="task-calendar-title" data-independent-calendar hidden="@(Model.Input.ProcessId != OperationalSequence.GeneralId)">
                    <h3 id="task-calendar-title">Calendario y plazo</h3>
                    <label class="campo"><span class="campo__etiqueta">Periodicidad o tarea ocasional</span><select class="campo__control" asp-for="Input.PeriodType" data-task-period>@foreach (var code in OperationalSchedule.Periods) { <option value="@code">@IndexModel.Label(code)</option> }</select></label>
                    <div class="task-form__grid" data-periodic-fields>
                        <label class="campo task-form__wide"><span class="campo__etiqueta">Calendario de ejecución</span><select class="campo__control" asp-for="Input.ScheduleMode" data-schedule-mode><option value="DISTRIBUIDA">Repeticiones distribuidas en el periodo</option><option value="DIAS_FIJOS">Días fijos de la semana</option><option value="PROGRESO">Progreso durante la semana (tarea pasiva)</option></select></label>
                        <label class="campo task-form__number"><span class="campo__etiqueta">Repeticiones por periodo</span><input class="campo__control" asp-for="Input.Repetitions" type="number" min="1" max="100" required /></label>
                        <label class="campo task-form__number"><span class="campo__etiqueta">Hora de activación · Ciudad de México</span><input class="campo__control" asp-for="Input.StartTime" type="time" step="60" required /><small class="task-form__help">Hora local con precisión de minutos. El inicio organiza la agenda; la entrega puede realizarse anticipadamente.</small></label>
                        <label class="campo task-form__wide" data-month-days hidden="@(Model.Input.PeriodType != "MENSUAL")"><span class="campo__etiqueta">Días preferidos del mes</span><input class="campo__control" asp-for="Input.PreferredMonthDays" maxlength="83" placeholder="Ejemplo: 8,22" disabled="@(Model.Input.PeriodType != "MENSUAL")" /><small class="task-form__help">Fechas recurrentes. Si no hay capacidad o cae domingo se busca hasta dos días antes o después, en el mismo mes y plan. Las fechas inexistentes quedan pendientes.</small></label>
                        <fieldset class="task-form__group task-form__wide" data-fixed-days hidden="@(Model.Input.ScheduleMode != "DIAS_FIJOS")"><legend>Días de ejecución</legend>
                            <div class="task-form__days">@foreach (var d in new[] { 1, 2, 3, 4, 5, 6, 0 }) { <label class="task-form__check"><input type="checkbox" name="InputDays" value="@d" checked="@Model.InputDays.Contains(d)" /><span>@(new[] { "Domingo", "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado" }[d])</span></label> }</div>
                            <small class="task-form__help">Usa periodicidad semanal. Cada día seleccionado genera una repetición.</small>
                        </fieldset>
                        <div class="task-form__grid task-form__wide" data-progress-goal hidden="@(Model.Input.ScheduleMode != "PROGRESO")">
                            <label class="campo task-form__number"><span class="campo__etiqueta">Meta semanal</span><input class="campo__control" asp-for="Input.GoalUnits" type="number" min="1" max="1000000" /></label>
                            <label class="campo"><span class="campo__etiqueta">Unidad de progreso</span><input class="campo__control" asp-for="Input.ProgressUnit" maxlength="60" /><small class="task-form__help">Ejemplo: pares revisados. Se acumulan avances hasta completar la meta.</small></label>
                        </div>
                        <label class="task-form__check task-form__wide" data-different-people><input asp-for="Input.DifferentPeople" /><span>Priorizar personas distintas en la semana; si faltan, repetir entre quienes tengan capacidad</span></label>
                    </div>
                    <p class="task-form__note" data-occasional-help hidden>Esta tarea solo se genera con Asignar tarea ocasional. En cada ocasión se eligen inicio, vencimiento, destinatarios y material.</p>
                    <label class="campo" data-sunday-time hidden="@(!showSundayTime)"><span class="campo__etiqueta">Horario dominical</span><input class="campo__control" asp-for="Input.SundayStartTime" type="time" step="60" disabled="@(!showSundayTime)" /><small>Opcional. Sustituye la hora de activación del domingo. Vacío conserva la hora habitual.</small></label>
                    <p>El cierre de nuevas asignaciones se calcula desde la activación asignada, según carga y margen global. Las metas por progreso conservan cierre semanal; las asignaciones anteriores conservan sus fechas.</p>
                    <p class="task-form__note">Ejemplo: «Regar árboles», días fijos lunes y jueves, activación a las 9 y plazo de 12 horas. En tareas pasivas, la carga representa el esfuerzo de toda la meta; el plazo termina al cerrar la semana.</p>
                </section>
<section class="task-form__section" aria-labelledby="task-options-title">
                    <h3 id="task-options-title">Carga y opciones</h3>
                    <label class="campo"><span class="campo__etiqueta">Criticidad operativa</span><select class="campo__control" asp-for="Input.OperationalCriticality" required><option value="">Selecciona criticidad</option><option value="CRITICA">Crítica</option><option value="IMPORTANTE">Importante</option><option value="FLEXIBLE">Flexible</option></select><small>Crítica conserva su hora; importante y flexible pueden retrasarse dentro del día. Las asignaciones publicadas conservan sus parámetros.</small></label>
                    <label class="campo task-form__number"><span class="campo__etiqueta">Carga por repetición (minutos estimados)</span><input class="campo__control" asp-for="Input.LoadMinutes" type="number" min="1" max="4800" required /></label>
                    <label class="task-form__check"><input asp-for="Input.Active" /><span>Activa para nuevas asignaciones</span></label>
                    <div>
                        <label class="task-form__check"><input asp-for="Input.IsWeeklyOperationsTask" data-task-weekly-operations disabled="@(Model.Input.PeriodType != "SEMANAL")" /><span>Es parte del plan de operaciones semanal</span></label>
                        <small class="task-form__help task-form__check-help">Solo disponible para tareas de periodicidad semanal del proceso General.</small>
                    </div>
                </section>
                <div class="modal__acciones task-form__actions"><a class="boton boton--secundario" href="@Model.CancelUrl">Cancelar</a><button class="boton boton--primario" type="submit">Guardar tarea</button></div>
            </form>
        </section>
    }
    <p>Un plan semanal incluye las fechas que correspondan de cada calendario, también las tareas mensuales. El reparto considera la capacidad disponible y los avances pendientes.</p>
    @if (Model.CanManage) { <p id="task-selection-help">Selecciona una tarea haciendo clic en su fila o en su selector para habilitar las acciones del panel flotante.</p> }
    @if (Model.Items.Count == 0) { <p class="estado-vacio">No se encontraron tareas.</p> }
    else {
        <div class="tabla-contenedor"><table class="tabla"><thead class="tabla__encabezado"><tr><th>Proceso</th><th>Tarea</th><th>Rol asignado</th><th>Especialización</th><th>Requisito</th><th>Periodicidad</th><th>Repeticiones</th><th>Plazo nuevo</th><th>Criticidad operativa</th><th>Carga</th><th>Estado</th></tr></thead><tbody>
        @foreach (var task in Model.Items) {
            <tr class="tabla__fila" data-task-row="@(Model.CanManage ? task.Id.ToString() : null)" data-task-name="@task.Name" data-task-code="@task.TaskCode" data-task-revision="@task.Revision" data-task-active="@task.Active.ToString().ToLowerInvariant()" data-task-assignable="@((task.ProcessId == OperationalSequence.GeneralId && task.PeriodType == "OCASIONAL" && task.Active).ToString().ToLowerInvariant())"><td><a href="/tareas/procesos?id=@task.ProcessId">@Model.ProcessName(task.ProcessId)</a></td><td>@if (Model.CanManage) { <input class="task-selection" type="radio" name="selected-task" value="@task.Id" aria-label="Seleccionar @task.TaskCode: @task.Name" aria-describedby="task-selection-help" /> }<strong>@task.Name</strong>@if (!string.IsNullOrWhiteSpace(task.Description)) { <details><summary>Ver descripción</summary><p class="supervision-text">@task.Description</p></details> }<br /><small>@task.TaskCode</small>@if (Model.RefreshCounts.GetValueOrDefault(task.Id) is var stale && stale > 0) { <br /><small>@stale asignaciones pendientes con cambios</small> }<br /><small>@(task.PreferredMonthDays.Length > 0 ? $"Días del mes: {task.PreferredMonthDays}" : task.PeriodType == "OCASIONAL" ? "Se asigna cuando se necesita" : task.ScheduleMode == "PROGRESO" ? $"Meta: {task.GoalUnits} {task.ProgressUnit}" : task.ScheduleMode == "DIAS_FIJOS" ? string.Join(", ", Enumerable.Range(0, 7).Where(d => (task.WeekDays & (1 << d)) != 0).Select(d => new[] { "Dom", "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb" }[d])) : "Distribución por calendario") @(task.PeriodType == "OCASIONAL" ? "" : $"· {task.StartHour:00}:{task.StartMinute:00}")</small></td><td>@IndexModel.RoleLabel(task.AssignedRole)</td><td>@(task.SpecializationId == null ? "No requiere especialización" : Model.Specializations.SingleOrDefault(s => s.Id == task.SpecializationId)?.Name ?? "Especialización inactiva")</td><td>@IndexModel.Label(task.Requirement)</td><td>@(task.ProcessId == OperationalSequence.GeneralId ? IndexModel.Label(task.PeriodType) : "Inicio por proceso")</td><td>@(task.PeriodType == "OCASIONAL" ? "—" : task.Repetitions.ToString())</td><td>@(task.ProcessId != OperationalSequence.GeneralId ? "Reglas del proceso" : task.ScheduleMode == "PROGRESO" ? "Cierre semanal" : $"Carga + {Model.SchedulingPolicy?.MarginPercent ?? 50}%")</td><td>@OperationalAgenda.Label(task.OperationalCriticality)</td><td>@task.LoadMinutes min</td><td>@(task.Active ? "Activa" : "Inactiva")</td></tr>
        }
        </tbody></table></div>
    }
    @if (Model.CanManage && Model.Items.Count > 0)
    {
        <aside class="task-action-panel" aria-label="Acciones de la tarea">
            <div class="task-action-panel__selection" role="status" aria-live="polite"><strong data-task-selection-label>Ninguna tarea seleccionada</strong><small data-task-selection-hint>Selecciona una tarea para habilitar las acciones.</small></div>
            <div class="task-action-panel__buttons">
                <button class="boton boton--secundario" type="button" data-task-edit disabled>Editar</button>
                <form method="post" asp-page-handler="Change" data-task-change><input type="hidden" name="id" disabled /><input type="hidden" name="revision" disabled /><button class="boton boton--secundario" type="submit" data-task-toggle disabled>Activar / Desactivar</button></form>
                <button class="boton boton--secundario" type="button" data-dialog-open aria-controls="task-delete" data-task-delete disabled>Eliminar</button>
                <button class="boton boton--primario" type="button" data-task-assign disabled>Asignar tarea ocasional</button>
            </div>
        </aside>
        <dialog id="task-delete" class="modal" aria-labelledby="task-delete-title"><div class="modal__contenido">
            <h2 id="task-delete-title">Eliminar tarea</h2><p>Se quitará «<strong data-task-delete-name></strong>» del catálogo. Las asignaciones anteriores conservarán su historia.</p>
            <form method="post" asp-page-handler="Change" data-task-change><input type="hidden" name="id" disabled /><input type="hidden" name="revision" disabled /><input type="hidden" name="delete" value="true" /><div class="modal__acciones"><button class="boton boton--secundario" type="button" data-dialog-close data-initial-focus>Cancelar</button><button class="boton boton--primario" type="submit" data-task-delete-confirm disabled>Eliminar tarea</button></div></form>
        </div></dialog>
        <noscript><p>Activa JavaScript para seleccionar tareas y usar el panel de acciones.</p></noscript>
    }
</section>
@section Scripts { <script src="~/js/task-actions.js" asp-append-version="true"></script> <script src="~/js/task-process.js" asp-append-version="true"></script> <script src="~/js/task-calendar.js" asp-append-version="true"></script> }
