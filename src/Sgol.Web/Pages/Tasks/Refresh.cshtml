@page "/tareas/actualizar"
@model Sgol.Web.Pages.Tasks.RefreshModel
@using Sgol.Web.Pages.Tasks
@{ ViewData["Title"] = "Actualizar Asignaciones"; }
<link rel="stylesheet" href="~/css/assignment-refresh.css" asp-append-version="true" />
<section class="assignment-refresh" aria-labelledby="refresh-title">
    <header class="assignment-refresh__header">
        <div><h1 id="refresh-title" class="encabezado-pagina__titulo">Actualizar Asignaciones</h1><p>Revisa los pendientes que cambiarán. Nada se guarda hasta que confirmes.</p></div>
        <a class="boton boton--secundario" href="/tareas">Volver a Tareas</a>
    </header>
    @if (Model.Error != null) { <div class="assignment-refresh__issues" role="alert"><p>@Model.Error</p></div> }
    @if (Model.Preview is {} preview)
    {
        var retired = preview.Differences.Count(d => d.Retire || d.After == null);
        var updated = preview.Differences.Length - retired;
        var pendingDecisions = preview.Decisions.Count(d => !d.Accepted);
        var otherConflicts = preview.Conflicts.Except(preview.DecisionConflicts).ToArray();
        var reviewStep = preview.Decisions.Length > 0 ? 2 : 1;
        <div class="assignment-refresh__summary" role="status">
            <div><strong>@updated</strong><span>@(updated == 1 ? "pendiente para actualizar" : "pendientes para actualizar")</span></div>
            <div><strong>@retired</strong><span>@(retired == 1 ? "pendiente para retirar" : "pendientes para retirar")</span></div>
            <div><strong>@preview.Excluded</strong><span>entregas y cierres que se conservan</span></div>
        </div>
        @if (preview.CalendarPreservations.Length > 0) { <p role="status">@preview.CalendarPreservations.Length decisiones de conservación por confirmar. No cambian las asignaciones; se guardan como excepciones hasta que cambie el catálogo.</p> }
        @if (preview.Decisions.Length > 0 || preview.Differences.Length > 0 || preview.Conflicts.Length > 0)
        {
        <form method="post" asp-page-handler="Preview" class="assignment-refresh__options" data-refresh-options>
            <input type="hidden" name="Reason" value="@Model.Reason" />
            @if (preview.Decisions.Length > 0)
            {
                <h2>1. Resuelve los casos pendientes</h2>
                <p>Elige la solución de cada caso y pulsa <strong>Revisar cambios</strong>.</p>
                @foreach (var decision in preview.Decisions)
                {
                    var field = decision.Code.StartsWith("calendar-preserve:") ? nameof(Model.PreserveCalendarAssignmentIds) : decision.AssignmentId != null ? nameof(Model.PreserveProcessAssignmentIds) : RefreshModel.DecisionField(decision.Code);
                    var value = decision.AssignmentId?.ToString() ?? "true";
                    var text = RefreshCaseText.Decision(decision);
                    var caseId = "refresh-case-" + decision.Code.Replace(":", "-");
                    <article class="assignment-refresh__case" aria-labelledby="@(caseId + "-title")">
                        <ul class="assignment-refresh__case-tasks" id="@(caseId + "-title")">
                        @foreach (var code in decision.TaskCodes) { <li><strong>@code</strong> <span>@Model.DecisionTasks.GetValueOrDefault(code, code)</span></li> }
                        </ul>
                        @if (decision.Context != null) { <p class="assignment-refresh__context">@decision.Context</p> }
                        <p id="@(caseId + "-cause")"><span class="assignment-refresh__caption">Motivo</span> @text.Cause</p>
                        <label class="assignment-refresh__choice @(decision.Accepted ? "assignment-refresh__choice--accepted" : "")">
                            <input type="checkbox" name="@field" value="@value" checked="@decision.Accepted" aria-describedby="@(caseId + "-cause") @(caseId + "-effect")" />
                            <span><strong>@text.Action</strong><span id="@(caseId + "-effect")">@text.Effect</span><small data-refresh-choice-status>@(decision.Accepted ? "Incluido en la revisión" : "Sin seleccionar")</small></span>
                        </label>
                        <details class="assignment-refresh__details"><summary>Ver detalles</summary>
                            @if (decision.Problem != null) { <p>@decision.Problem</p> }
                            <p>@decision.Help</p>
                        </details>
                    </article>
                }
                @if (pendingDecisions > 0) { <p class="assignment-refresh__pending" role="status">@(pendingDecisions == 1 ? "Falta 1 opción por autorizar para poder continuar." : $"Faltan {pendingDecisions} opciones por autorizar para poder continuar.")</p> }
            }
            <button type="submit" class="boton boton--primario">@(preview.Decisions.Length > 0 ? "Revisar cambios" : "Volver a revisar")</button>
            <p data-refresh-dirty hidden role="status">Cambiaste las opciones. Pulsa Revisar cambios para ver el nuevo resultado antes de confirmar.</p>
        </form>
        }
        @if (otherConflicts.Length > 0)
        {
            <section class="assignment-refresh__blocked" aria-labelledby="refresh-blocked-title">
                <h2 id="refresh-blocked-title">Casos que debes resolver antes de continuar</h2>
                @foreach (var issue in preview.Issues)
                {
                    var text = RefreshCaseText.Issue(issue);
                    <article class="assignment-refresh__case assignment-refresh__case--blocked">
                        <h3>@(issue.TaskCode ?? "Actualización general") @issue.TaskName</h3>
                        @if (issue.Context != null) { <p class="assignment-refresh__context">@issue.Context</p> }
                        <p><span class="assignment-refresh__caption">Motivo</span> @text.Cause</p>
                        <p><span class="assignment-refresh__caption">Solución</span> @text.Action</p>
                        @if (text.Url != null) { <a href="@text.Url" class="assignment-refresh__case-link">@(text.Url == "/tareas/procesos" ? "Ir a Procesos" : text.Url == "/planificacion" ? "Ir a Planificación" : text.Url == "/validaciones" ? "Ir a Supervisión" : "Ir a Tareas")</a> }
                        <details class="assignment-refresh__details"><summary>Ver detalles</summary>
                            <p>@issue.Detail</p>
                            @if (RefreshCaseText.Changes(issue, Model.SpecializationNames, Model.ProcessNames) is { Length: > 0 } changes)
                            {
                                <p><strong>Cambios del catálogo pendientes de aplicar a esta asignación</strong></p>
                                <ul class="assignment-refresh__changes">
                                @foreach (var change in changes)
                                {
                                    <li><strong>@change.Field</strong><br />En la asignación: @change.Before<br />En el catálogo actual: @change.Current</li>
                                }
                                </ul>
                                <p>Estos cambios aún no se han aplicado a esta asignación. El motivo anterior indica qué impide continuar; la comparación no atribuye el bloqueo a un único parámetro.</p>
                            }
                            else if (issue.Code == "capacity")
                            {
                                <p>Esta asignación no tiene diferencias directas con el catálogo. El conflicto se detectó al reacomodar la agenda por los cambios de otras asignaciones de esta revisión.</p>
                            }
                        </details>
                    </article>
                }
                @foreach (var conflict in otherConflicts.Except(preview.Issues.Select(i => i.Detail)))
                {
                    <article class="assignment-refresh__case"><h3>Actualización general</h3><p>@conflict</p><p><span class="assignment-refresh__caption">Solución</span> Revisa el caso indicado y vuelve a calcular.</p></article>
                }
            </section>
        }
        @foreach (var notice in preview.Notices) { <p class="assignment-refresh__notice">@notice</p> }
        @if (preview.Differences.Length > 0)
        {
            <section aria-labelledby="refresh-results-title"><h2 id="refresh-results-title">@reviewStep. Revisa el resultado propuesto</h2>
            @foreach (var group in preview.Differences.GroupBy(d => (d.After ?? d.Before)!.TaskId).OrderBy(g => (g.First().After ?? g.First().Before)!.TaskCode))
            {
                var task = (group.First().After ?? group.First().Before)!;
                var withdrawn = group.Count(d => d.Retire || d.After == null);
                var changes = group.Where(d => !d.Retire && d.After != null).SelectMany(RefreshModel.Changes).Distinct().ToArray();
                <article class="assignment-refresh__task">
                    <header><div><small>@task.TaskCode</small><h3>@task.Name</h3></div><span>@(group.Count() - withdrawn) para actualizar · @withdrawn para retirar</span></header>
                    @if (withdrawn > 0) { <p>@(withdrawn == 1 ? "Se quitará 1 pendiente" : $"Se quitarán {withdrawn} pendientes") del trabajo activo. Sus avances y archivos se conservarán como historial.</p> }
                    @if (group.All(d => d.MetadataOnly)) { <p>Solo cambian los datos de la tarea. Se conservan el responsable, el horario, el estado y el avance.</p> }
                    @if (changes.Length > 0) { <ul class="assignment-refresh__changes">@foreach (var change in changes) { <li>@change</li> }</ul> }
                    <details><summary>@(group.Count() == 1 ? "Ver la asignación" : $"Ver las {group.Count()} asignaciones")</summary>
                        <div class="tabla-contenedor"><table class="tabla"><thead class="tabla__encabezado"><tr><th>Responsable</th><th>Acción</th><th>Fechas</th><th>Avance conservado</th></tr></thead><tbody>
                        @foreach (var diff in group)
                        {
                            var row = (diff.After ?? diff.Before)!;
                            <tr class="tabla__fila"><td>@row.PersonName<br /><small>@Model.Plans.GetValueOrDefault(row.PlanId, "Plan")</small></td>
                                <td>@(diff.Retire || diff.After == null ? "Retirar del trabajo activo" : diff.Before == null ? "Agregar" : diff.PreservesExpiredAgenda ? "Actualizar sin reacomodar el día pasado" : "Actualizar")</td>
                                <td>@if (diff.Retire || diff.After == null) { <span>Dejará de aparecer como pendiente.</span> } else if (diff.Before is {} before && (before.StartsAt != row.StartsAt || before.DueAt != row.DueAt)) { <span>Antes: @RefreshModel.Date(before.StartsAt) → @RefreshModel.Date(before.DueAt)</span><br /><strong>Nuevo: @RefreshModel.Date(row.StartsAt) → @RefreshModel.Date(row.DueAt)</strong> } else { <span>Se conserva el horario.</span><br /><small>Vence: @RefreshModel.Date(row.DueAt)</small> }</td>
                                <td>@if (row.ProgressUnits > 0 || row.ScheduleMode == "PROGRESO") { <span>@row.ProgressUnits @row.ProgressUnit</span> } else { <span>Sin avance registrado</span> }</td>
                            </tr>
                        }
                        </tbody></table></div>
                    </details>
                </article>
            }
            </section>
        }
        @if (preview.CanApply)
        {
            <form method="post" asp-page-handler="Apply" class="assignment-refresh__confirm" data-refresh-apply>
                <h2>@(preview.Differences.Length == 0 ? reviewStep : reviewStep + 1). @(preview.Differences.Length == 0 ? "Confirma la conservación" : "Confirma la actualización")</h2>
                <input type="hidden" asp-for="Key" /><input type="hidden" asp-for="NotBefore" /><input type="hidden" asp-for="Fingerprint" />
                <input type="hidden" asp-for="ReplaceRemainingEstimate" /><input type="hidden" asp-for="ChangeAuthorizedDeadline" /><input type="hidden" asp-for="AdoptLegacyCalendar" /><input type="hidden" asp-for="RetireInactiveAssignments" /><input type="hidden" asp-for="RetireExcludedAssignments" />
                @foreach (var id in Model.PreserveProcessAssignmentIds) { <input type="hidden" name="PreserveProcessAssignmentIds" value="@id" /> }
                @foreach (var id in Model.PreserveCalendarAssignmentIds) { <input type="hidden" name="PreserveCalendarAssignmentIds" value="@id" /> }
                <label class="campo"><span class="campo__etiqueta">Motivo para el historial</span><textarea class="campo__control" asp-for="Reason" maxlength="1000" required rows="2" placeholder="Por ejemplo: Actualizar requisitos y retirar tareas que ya no se realizan"></textarea></label>
                <p>Se guardarán los cambios y las decisiones mostrados arriba.</p>
                <button class="boton boton--primario" type="submit">@(preview.Differences.Length == 0 ? "Confirmar conservación" : retired == 0 ? "Confirmar cambios" : updated == 0 ? "Confirmar retiros" : "Confirmar cambios y retiros")</button>
            </form>
        }
        else if (preview.Differences.Length == 0 && preview.Conflicts.Length == 0) { <p>No hay cambios ni decisiones pendientes de confirmar.</p> }
    }
</section>
<script src="~/js/assignment-refresh.js" asp-append-version="true" defer></script>


