ASPNETCORE_ENVIRONMENT=Staging
ASPNETCORE_URLS=http://+:8080
TZ=Etc/UTC
DOTNET_EnableDiagnostics=0
SGOL_REVISION=REQUIRED_GIT_SHA
SGOL_IMAGE_DIGEST=REQUIRED_OCI_DIGEST
Evidence__Storage__Endpoint=https://s3.staging.example.invalid
Evidence__Storage__Region=staging-region-1
Evidence__Storage__QuarantineBucket=sgol-staging-evidence-quarantine
Evidence__Storage__CleanBucket=sgol-staging-evidence-clean
Evidence__Storage__AllowInsecureTransport=false
Evidence__Storage__AllowedUploadOrigins__0=https://sgol.staging.example.invalid
Evidence__Scanner__Host=clamd.staging.internal
Evidence__Scanner__Port=3310
Evidence__Scanner__ConnectTimeoutSeconds=3
Evidence__Scanner__ScanTimeoutSeconds=30
DataProtection__ApplicationName=SGOL
Backup__Storage__Endpoint=https://s3-backup.staging.example.invalid
Backup__Storage__Region=staging-region-2
Backup__Storage__Bucket=sgol-staging-portable-backups
Backup__Storage__Prefix=postgresql/v1
Backup__Storage__AllowInsecureTransport=false
Backup__Encryption__Recipient=REQUIRED_PUBLIC_AGE_RECIPIENT
Backup__PgDumpPath=/usr/bin/pg_dump
Backup__AgePath=/usr/bin/age
Backup__MaximumAttempts=3
Backup__StorageTimeoutSeconds=60
Backup__ProcessTimeoutSeconds=900
Replica__Source__Endpoint=https://s3.staging.example.invalid
Replica__Source__Region=staging-region-1
Replica__Source__QuarantineBucket=sgol-staging-evidence-quarantine
Replica__Source__CleanBucket=sgol-staging-evidence-clean
Replica__Source__AllowInsecureTransport=false
Replica__Destination__Endpoint=https://s3-backup.staging.example.invalid
Replica__Destination__Region=staging-region-2
Replica__Destination__QuarantineBucket=sgol-staging-evidence-quarantine-replica
Replica__Destination__CleanBucket=sgol-staging-evidence-clean-replica
Replica__Destination__ManifestBucket=sgol-staging-portable-backups
Replica__Destination__ManifestPrefix=objects/v1
Replica__Destination__AllowInsecureTransport=false
Replica__MaximumAttempts=3
Replica__TimeoutSeconds=60
Replica__BatchSize=500
Restore__ExpectedMigration=20260912213000_AddPortableDataProtectionKeyRing
